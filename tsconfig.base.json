{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@nordri/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@nordri/ai-evals": ["packages/ai-evals/src/index.ts"],
      "@nordri/ai-providers": ["packages/ai-providers/src/index.ts"],
      "@nordri/browser-agent": ["packages/browser-agent/src/index.ts"],
      "@nordri/browser-runtime": ["packages/browser-runtime/src/index.ts"],
      "@nordri/contracts": ["packages/contracts/src/index.ts"],
      "@nordri/core": ["packages/core/src/index.ts"],
      "@nordri/db": ["packages/db/src/index.ts"],
      "@nordri/knowledge-base": ["packages/knowledge-base/src/index.ts"],
      "@nordri/job-finder/discovery-ordering": [
        "packages/job-finder/src/discovery-ordering.ts"
      ],
      "@nordri/job-finder/discovery-result-bands": [
        "packages/job-finder/src/discovery-result-bands.ts"
      ],
      "@nordri/job-finder/resume-record-identity": [
        "packages/job-finder/src/resume-record-identity.ts"
      ],
      "@nordri/job-finder/plan-safeguard-pauses": ["packages/job-finder/src/plan-safeguard-pauses.ts"],
      "@nordri/job-finder/source-health": [
        "packages/job-finder/src/source-health.ts"
      ],
      "@nordri/job-finder/source-instruction-review": [
        "packages/job-finder/src/source-instruction-review.ts"
      ],
      "@nordri/job-finder": ["packages/job-finder/src/index.ts"],
      "@nordri/live-assistant": [
        "packages/live-assistant/src/index.ts"
      ],
      "@nordri/os-integration": ["packages/os-integration/src/index.ts"],
      "@nordri/testing": ["packages/testing/src/index.ts"]
    }
  }
}
